# ARC Investment Platform - Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env with real credentials to version control

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
APP_NAME="ARC Investment Platform"

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=arc
DB_USERNAME=arc
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# REDIS (Cache)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# API (Nexus)
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
API_PREFIX=/api/v1
API_DOCS_URL=/docs
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60
API_JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
API_JWT_ALGORITHM=HS256
API_JWT_EXPIRATION_MINUTES=60
API_JWT_REFRESH_EXPIRATION_DAYS=7

# =============================================================================
# DATA PROVIDERS
# =============================================================================

# EODHD (Market Data)
# Get API key at: https://eodhd.com/
PROVIDER_EODHD_API_KEY=your_eodhd_api_key
PROVIDER_EODHD_BASE_URL=https://eodhd.com/api

# Capital IQ (Fundamentals) - Optional
PROVIDER_CAPITALIQ_USERNAME=
PROVIDER_CAPITALIQ_PASSWORD=
PROVIDER_CAPITALIQ_BASE_URL=

# Pitchbook (Private Markets) - Optional
PROVIDER_PITCHBOOK_API_KEY=
PROVIDER_PITCHBOOK_BASE_URL=

# =============================================================================
# KAIZEN (AI Agents)
# =============================================================================

# LLM Provider: openai, anthropic, or ollama
KAIZEN_PROVIDER=anthropic
KAIZEN_MODEL=claude-sonnet-4-20250514

# OpenAI API Key (if using openai provider)
# Get API key at: https://platform.openai.com/
KAIZEN_OPENAI_API_KEY=your_openai_api_key

# Anthropic API Key (if using anthropic provider)
# Get API key at: https://console.anthropic.com/
KAIZEN_ANTHROPIC_API_KEY=your_anthropic_api_key

# Ollama Settings (if using ollama provider)
KAIZEN_OLLAMA_BASE_URL=http://localhost:11434

# Model Settings
KAIZEN_TEMPERATURE=0.7
KAIZEN_MAX_TOKENS=4096

# Memory Settings
KAIZEN_MEMORY_TYPE=buffer
KAIZEN_MAX_MEMORY_ITEMS=100

# =============================================================================
# SSO (Single Sign-On) - OAuth Providers
# =============================================================================

# Azure AD (Multi-Tenant)
# Get credentials at: https://portal.azure.com/ → App registrations
SSO_AZURE_CLIENT_ID=
SSO_AZURE_CLIENT_SECRET=
SSO_AZURE_TENANT_ID=common

# Google Workspace
# Get credentials at: https://console.cloud.google.com/apis/credentials
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

# GitHub
# Get credentials at: https://github.com/settings/developers
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=

# SSO General Settings
SSO_REDIRECT_BASE_URL=http://localhost:3000

# Encryption key for storing client secrets securely
# CRITICAL: Generate a new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts OAuth client secrets at rest in the database
SSO_SECRET_ENCRYPTION_KEY=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true

# =============================================================================
# WEB FRONTEND (Next.js)
# =============================================================================
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# INTEGRATION TESTS
# =============================================================================
# These are used by docker-compose.test.yml
# Tests run on different ports to avoid conflicts with development
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_DATABASE=arc_test
TEST_DB_USERNAME=arc_test
TEST_DB_PASSWORD=arc_test_password

TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit .env files to version control
# 2. Generate secrets with:
#    - JWT Secret: openssl rand -hex 32
#    - DB Password: openssl rand -hex 16
#    - Redis Password: openssl rand -hex 16
# 3. Use secrets management tools in production:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Kubernetes Secrets
# 4. Rotate secrets regularly (quarterly for production)
# 5. Use different credentials for each environment
